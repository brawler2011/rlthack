              },
              {
                "type": "null"
              }
            ],
            "title": "Lot Id"
          },
          "new_limit": {
            "description": "New suppliers to suggest",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "New Limit",
            "type": "integer"
          }
        },
        "required": [
          "lot_id",
          "lot",
          "filters",
          "limit",
          "new_limit"
        ],
