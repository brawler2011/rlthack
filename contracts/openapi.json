      "SearchRequest": {
        "additionalProperties": false,
        "description": "Either an existing lot (lot_id) or a new one (lot).",
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "limit": {
            "maximum": 100.0,
            "minimum": 1.0,
