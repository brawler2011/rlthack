{
  "components": {
    "schemas": {
      "BatchResponse": {
        "additionalProperties": false,
        "properties": {
          "matched_lots": {
            "items": {
              "$ref": "#/components/schemas/MatchedLot"
            },
            "title": "Matched Lots",
            "type": "array"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "matched_lots"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "rlthack-recsys-backend",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LotBase": {
