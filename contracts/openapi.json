              }
            ],
            "description": "Over contested lots; None if none",
            "title": "Win Rate"
          }
        },
        "required": [
          "rank",
          "inn",
          "name",
          "role",
          "role_display",
          "role_reason",
          "score",
          "win_rate",
          "n_bids",
          "n_wins",
          "avg_won_price",
          "region_code",
          "is_spb_lo",
          "is_smp",
          "is_actual_winner",
          "explanation"
        ],
        "title": "SupplierRecommendation",
        "type": "object"
      },
      "ValidationErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ValidationErrorResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "additionalProperties": false,
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "XaiFactor": {
        "additionalProperties": false,
        "properties": {
          "impact": {
            "description": "Contribution to the rank score (SHAP); > 0 pushes up",
            "title": "Impact",
            "type": "number"
          },
          "name": {
            "description": "Feature key, e.g. customer_score",
            "title": "Name",
            "type": "string"
          },
          "text": {
            "description": "Human-readable reason with the actual value",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "name",
          "impact",
          "text"
        ],
        "title": "XaiFactor",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Recommendation service and Explainable AI (XAI) API for counterparty matching",
    "title": "Roseltorg • Intelligent Counterparty Selection Service AIS GZ",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/batch/simulate": {
      "post": {
        "description": "The background robot for one day: newly published notices, suppliers to invite for each\n(known ones with the reason, plus new companies from the SME registry).",
        "operationId": "simulate_batch",
        "parameters": [
          {
            "description": "Notices of this day; default: the last",
            "in": "query",
            "name": "day",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Notices of this day; default: the last",
              "title": "Day"
            }
          },
          {
            "in": "query",
            "name": "max_lots",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Max Lots",
              "type": "integer"
            }
          },
          {
            "description": "Known suppliers to invite",
            "in": "query",
            "name": "per_lot",
            "required": false,
            "schema": {
              "default": 5,
              "description": "Known suppliers to invite",
              "maximum": 20,
              "minimum": 1,
              "title": "Per Lot",
              "type": "integer"
            }
          },
          {
            "description": "New registry companies",
            "in": "query",
            "name": "new_per_lot",
            "required": false,
            "schema": {
              "default": 2,
              "description": "New registry companies",
              "maximum": 10,
              "minimum": 0,
              "title": "New Per Lot",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Simulate Batch Recommendations",
        "tags": [
          "Batch"
        ]
      }
    },
    "/api/v1/enrichment/{inn}": {
      "get": {
        "description": "Company card: bidding history from the data plus OKVED, role and size from the SME\nregistry. Works for new companies that never bid too.",
        "operationId": "get_enrichment",
        "parameters": [
          {
            "in": "path",
            "name": "inn",
            "required": true,
            "schema": {
              "title": "Inn",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplierCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Enrichment",
        "tags": [
          "Enrichment"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "The API is up; engine: idle / loading / ready / failed (search needs ready).",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Health Check",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/lots/search": {
      "get": {
        "description": "Find lots by subject text, lot id or registry number; newest first.",
        "operationId": "search_lots",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "default": "",
              "title": "Query",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LotListItem"
                  },
                  "title": "Response Search Lots",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Lots",
        "tags": [
          "Lots"
        ]
      }
    },
    "/api/v1/lots/{lot_id}": {
      "get": {
        "description": "A lot with its items, OKPD2 codes and the real winners.",
        "operationId": "get_lot",
        "parameters": [
          {
            "in": "path",
            "name": "lot_id",
            "required": true,
            "schema": {
              "title": "Lot Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Lot",
        "tags": [
          "Lots"
        ]
      }
    },
    "/api/v1/suppliers/search": {
      "post": {
        "description": "Rank suppliers for a lot from the data (lot_id) or a new one (lot), with explanations,\nplus new companies from the SME registry that fit the lot.",
        "operationId": "search_suppliers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Suppliers",
        "tags": [
          "Suppliers"
        ]
      }
    }
  }
}
