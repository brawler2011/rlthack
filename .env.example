# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# PostgreSQL (`task db:up` starts it in Docker)
DATABASE_URL=postgresql://rlthack:rlthack@localhost:5432/rlthack

# Data Paths
DATA_DIR=data
RAW_DATA_DIR=data/Данные 24-25
PROCESSED_DATA_DIR=data/processed
DICTIONARIES_DIR=data/dictionaries

# Models
MODELS_DIR=backend/models
CATBOOST_MODEL_PATH=backend/models/catboost_ranker.cbm
EMBEDDINGS_DIR=data/processed/embeddings
TRANSFORMER_MODEL_NAME=sergeyzh/rubert-tiny-turbo

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
